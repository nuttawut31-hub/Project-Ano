# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
# Project URL & Public Anonymous Key (Used in Client & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Secret Key (SERVER-ONLY: Used for bypassing RLS after AI moderation)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ==========================================
# OPENAI / AI MODERATION CONFIGURATION
# ==========================================
# API Key for OpenAI Moderation API & Intent Classification (SERVER-ONLY)
OPENAI_API_KEY=sk-your-openai-api-key
